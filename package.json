{
  "name": "sanjae-apply",
  "version": "0.5.5",
  "description": "산재 신청 도우미 — 급여 종류·재해 분기별 필요 서식·첨부·근거 조문, 근로복지공단 정본 PDF 채우기 (MCP·CLI). 승인 가능성은 계산하지 않고 입력을 저장하지 않는다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seojaehong/sanjae-apply"
  },
  "keywords": [
    "산재",
    "근로복지공단",
    "요양급여",
    "mcp",
    "model-context-protocol",
    "노무"
  ],
  "type": "module",
  "bin": {
    "sanjae-apply": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "forms/bundled",
    "forms/maps",
    "forms/hwpx",
    "forms/hwpx_maps",
    "forms/catalog.json",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "audit:coverage": "python scripts/audit_coverage.py && python scripts/audit_pdf_checks.py",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "build:web": "node scripts/build_web_data.mjs && esbuild web/engine.ts --bundle --format=esm --target=es2020 --outfile=public/app/engine.js && esbuild web/main.ts --bundle --format=esm --target=es2020 --external:./engine.js --outfile=public/app/main.js",
    "lint:web": "tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.0.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.2",
    "mcp-handler": "1.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  }
}
